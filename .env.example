# Telegram Bot Token (از BotFather@ در تلگرام دریافت کنید)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# تنظیمات پروکسی (در صورت نیاز برای سرورهای داخل ایران یا دور زدن فیلترینگ)
# نمونه‌ها:
# PROXY_URL=http://127.0.0.1:10809
# PROXY_URL=socks5://127.0.0.1:10808
# اگر به پروکسی نیاز ندارید یا روی سرور خارجی هستید، خالی بگذارید:
PROXY_URL=

# مسیر پایگاه داده
DB_PATH=gold_bot.db
